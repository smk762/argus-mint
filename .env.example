# Copy to .env (gitignored) for `make deploy`. Public RPCs are rate-limited; use a provider for real use.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org
ETHERSCAN_API_KEY=

# Deployer: a Foundry keystore account (`cast wallet import deployer --interactive`),
# so no private key sits in a file.
DEPLOYER_ACCOUNT=deployer

# Roles default to the deployer. In production use separate keys: SIGNER signs vouchers
# on the consumer's server, and ADMIN should be a multisig. Leave unused lines commented
# out: an empty value is not the same as unset.
# ADMIN=
# SIGNER=
# METADATA_OPERATOR=
# MINTER=
# COMMITTER=
# CARD_NAME=
# CARD_SYMBOL=
# CARD_BASE_URI=
# ROYALTY_RECEIVER=
# ROYALTY_BPS=0
