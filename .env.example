# Copy to .env (gitignored) for `make deploy`.
#
# RPC: any Base JSON-RPC endpoint works; deploys, mints, reads and indexing talk to it directly.
# Public endpoints (no key, rate-limited):
#   Base Sepolia: https://sepolia.base.org, https://base-sepolia-rpc.publicnode.com
#   Base:         https://mainnet.base.org, https://base-rpc.publicnode.com, https://base.api.pocket.network
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Only for `make deploy VERIFIER=etherscan` (Basescan). The default, Sourcify, needs no key.
ETHERSCAN_API_KEY=

# CLI cards: draft / review / publish (these can also be exported in the shell):
# ARGUS_MINT_DARKROOM_URL=http://127.0.0.1:8106
# ARGUS_MINT_WRITER_URL=http://<AGENT_HOST>:9150   # bio writer (POST /chat), for draft --bio
# ARGUS_MINT_WRITER_KEY=                        # its bearer token, if it needs one
# ARGUS_MINT_IPFS_API=http://127.0.0.1:5001     # `make ipfs` starts a local Kubo node
# ARGUS_MINT_ACCOUNT=deployer                   # keystore that signs vouchers and sends txs
# ARGUS_MINT_KEYSTORE_PASSWORD_FILE=            # unattended: file holding its password (mode 600)
# ARGUS_MINT_RPC_URL=                           # default: the network's public endpoints

# Deployer: a Foundry keystore account (`cast wallet new deployer`; see docs/deploy.md),
# so no private key sits in a file.
DEPLOYER_ACCOUNT=deployer

# Roles default to the deployer. In production use separate keys: SIGNER signs vouchers
# on the consumer's server, and ADMIN should be a multisig. Leave unused lines commented
# out: an empty value is not the same as unset.
# ADMIN=
# SIGNER=
# METADATA_OPERATOR=
# MINTER=
# COMMITTER=
# CARD_NAME=
# CARD_SYMBOL=
# CARD_BASE_URI=
# DEED_NAME=
# DEED_SYMBOL=
# ROYALTY_RECEIVER=
# ROYALTY_BPS=0

# argus-mint serve (`make serve`, or `make serve-up` for docker): the HTTP service for argus-studio / argus-assay.
# ARGUS_MINT_MODERATOR_TOKEN=                   # long random string: creates drafts, moderates, publishes
# ARGUS_MINT_SIWE_DOMAIN=localhost:3108         # the UI's host[:port]; owners sign in there to review
# ARGUS_MINT_CARD=0x…                           # Card contract the vouchers are for
# ARGUS_MINT_NETWORK=base-sepolia
# ARGUS_MINT_CORS_ORIGINS=http://localhost:3000,http://localhost:3108
# ARGUS_MINT_DRAFTS_DIR=drafts
# ARGUS_MINT_READ_ONLY=0
# ARGUS_MINT_AUTO_MODERATE=0                  # 1: platform checks approve as the moderator when all pass
# ARGUS_MINT_BLOCKLIST=                        # extra word-filter terms, one per line

# ── Agent tooling (not read by this service) ──
# ai-code-auditor audit API base that AGENTS.md tells coding agents to use.
# Put the real host/IP in your local .env, never here.
# AI_AUDIT_PUBLIC_BASE_URL=http://<AUDIT_HOST>:8765
